{
  "manifest_version": 3,
  "name": "AuDioPrism",
  "version": "2.2.9",
  "description": "8D spatial audio mixer for YouTube Music, Spotify and Apple Music tabs. Runs entirely in your browser.",
  "icons": {
    "128": "icons/513d19b9-d3db-435d-bd2a-c31d8b8d5097.png"
  },
  "action": {
    "default_title": "Launch Prism",
    "default_popup": "popup.html",
    "default_icon": "icons/prism-icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*",
        "*://open.spotify.com/*",
        "*://play.spotify.com/*",
        "*://music.apple.com/*"
      ],
      "js": [
        "defaults.js",
        "hosts.js",
        "content.js"
      ]
    }
  ],
  "permissions": [
    "tabCapture",
    "offscreen",
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://open.spotify.com/*",
    "https://play.spotify.com/*",
    "https://music.apple.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/513d19b9-d3db-435d-bd2a-c31d8b8d5097.png",
        "icons/prism-icon.png"
      ],
      "matches": [
        "*://music.youtube.com/*",
        "*://open.spotify.com/*",
        "*://play.spotify.com/*",
        "*://music.apple.com/*"
      ]
    }
  ]
}
